{
  "name": "lz4-browser",
  "version": "1.0.1",
  "description": "Modern ESM rebuild of the LZ4 browser codec",
  "keywords": [
    "lz4",
    "compression",
    "decompression",
    "stream"
  ],
  "homepage": "https://github.com/Reiss-Cashmore/lz4-browser",
  "repository": {
    "type": "git",
    "url": "git://github.com/Reiss-Cashmore/lz4-browser.git"
  },
  "browser": "./build/lz4.js",
  "bugs": {
    "url": "http://github.com/Reiss-Cashmore/lz4-browser/issues"
  },
  "gypfile": true,
  "licenses": [
    {
      "type": "MIT",
      "url": "http://github.com/Reiss-Cashmore/lz4-browser/raw/master/LICENSE"
    }
  ],
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsup",
    "test": "vitest --run",
    "lint": "eslint .",
    "bench": "tsx benchmark/block-bench.ts",
    "release": "semantic-release"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "cuint": "^0.2.2",
    "js-xxhash": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^12.0.2",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "np": "^10.2.0",
    "semantic-release": "^24.2.9",
    "tinybench": "^5.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^7.2.4",
    "vitest": "^4.0.10"
  },
  "prepublishOnly": "npm run build"
}
